╭──────────────────────────────────────────────────────────────────────╮
│  رُمّان — إعدادات الخادم                                              │
│  انسخ هذا الملف إلى  server/.env  ثم املأ القيم.                      │
│  الخادم يرفض الإقلاع إن نقص أي إعداد مطلوب ويقول لك أيّها بالضبط.     │
╰──────────────────────────────────────────────────────────────────────╯

# ═══ الخادم ══════════════════════════════════════════════════════════
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# نطاقات الواجهة المسموح لها (مفصولة بفواصل).
# في الإنتاج: نطاقك فقط — لا localhost ولا *
CLIENT_ORIGIN=http://localhost:5173

# عنوان الواجهة كما يفتحه العميل — تُبنى منه روابط البريد
APP_URL=http://localhost:5173

# العنوان العام للـ API — تحتاجه فوري لإرسال إشعار الدفع (webhook)
# مطلوب في الإنتاج. مثال: https://api.your-domain.com
API_PUBLIC_URL=http://localhost:4000

# ═══ قاعدة البيانات (MySQL 8+) ═══════════════════════════════════════
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=rumman_market
DB_CONNECTION_LIMIT=10
DB_SSL=false

# ═══ أسرار التوكنات ══════════════════════════════════════════════════
# ولّد كلًّا منهما بأمر مستقل:   openssl rand -base64 48
# في الإنتاج يُرفض أي سرّ أقصر من 32 حرفًا أو يحمل كلمة change-me
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=30d

# ═══ العلامة ═════════════════════════════════════════════════════════
# تظهر في كل رسالة بريد وفي تذييل الفواتير
BRAND_NAME=رُمّان
BRAND_TAGLINE=مائدة تستحقّ الأفضل
SUPPORT_PHONE=
SUPPORT_EMAIL=

# ═══ البريد — Resend ═════════════════════════════════════════════════
# 1) أنشئ حسابًا على resend.com  2) أضف نطاقك وفعّل سجلّات DNS
# 3) أنشئ مفتاح API وضعه هنا
# بدون مفتاح: الرسائل تُكتب في سجلّ الخادم بدل إرسالها (تنبيه في كل مرّة)
RESEND_API_KEY=
# يجب أن يكون على نطاق موثّق لديك بعد التفعيل
MAIL_FROM=رُمّان <onboarding@resend.dev>
MAIL_REPLY_TO=

# ═══ وسائل الدفع ═════════════════════════════════════════════════════

# ── الدفع عند الاستلام ──
PAY_COD_ENABLED=true

# ── إنستاباي (تحويل يدوي يعتمده الفريق من لوحة الإدارة) ──
# لا توجد واجهة برمجية للتجّار، فالتدفّق: العميل يحوّل ← يرفع الإيصال
# ← الفريق يعتمد التحويل ← يبدأ التجهيز. كل خطوة مسجّلة.
PAY_INSTAPAY_ENABLED=false
INSTAPAY_ADDRESS=
INSTAPAY_ACCOUNT_NAME=
INSTAPAY_PROOF_WINDOW_HOURS=24

# ── فوري (FawryPay) ──
# احصل على البيانات من لوحة تاجر فوري
# الاختبار: https://atfawry.fawrystaging.com
# الإنتاج:  https://www.atfawry.com
PAY_FAWRY_ENABLED=false
FAWRY_MERCHANT_CODE=
FAWRY_SECURITY_KEY=
FAWRY_BASE_URL=https://atfawry.fawrystaging.com
FAWRY_EXPIRY_HOURS=24

# ═══ رفع الملفات ═════════════════════════════════════════════════════
UPLOAD_MAX_FILE_MB=5
# اتركه فارغًا ليُقدَّم من الخادم نفسه، أو ضع عنوان CDN
UPLOADS_PUBLIC_URL=

# ═══ قواعد العمل ═════════════════════════════════════════════════════
POINTS_PER_EGP=1              # نقطة ولاء لكل جنيه
POINT_VALUE_EGP=0.05          # قيمة النقطة عند الاستبدال
DEFAULT_TAX_RATE=0            # نسبة الضريبة الافتراضية
MAX_POINTS_REDEMPTION_PERCENT=50

# ═══ الحساب الأول (يُستخدم مرّة واحدة مع npm run db:bootstrap) ═══════
# بعد إنشاء الحساب احذف هذه السطور من الملف.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=
